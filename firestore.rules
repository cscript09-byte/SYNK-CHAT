rules_version = '2';
// SYNK — Cloud Firestore security rules
// Paste into Firebase Console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Creator accounts. Keep in sync with ADMIN_EMAILS in index.html.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['cscript09@gmail.com', 'alexartie347@gmail.com'];
    }
    function banned() { return exists(/databases/$(database)/documents/bans/$(me())); }
    // Signed in and not suspended
    function active() { return signedIn() && (!banned() || isAdmin()); }
    function inChat(chatId) { return me() in chatId.split('_'); }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn();
      // 'email' must be the real sign-in email, so nobody can fake the Creator badge
      allow create: if signedIn() && me() == uid && !('creator' in request.resource.data)
                    && (request.resource.data.get('email', '') == '' || request.resource.data.email == request.auth.token.email);
      allow update: if signedIn() && me() == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creator', 'uid'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
                        || request.resource.data.email == request.auth.token.email);
      allow delete: if signedIn() && (me() == uid || isAdmin());
    }

    // ---------- SYNK requests (id = from_to) ----------
    match /synkRequests/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.from || me() == resource.data.to || isAdmin());
      allow create: if active() && request.resource.data.from == me() && id == me() + '_' + request.resource.data.to;
      allow update: if active() && (me() == resource.data.from || me() == resource.data.to)
                    && request.resource.data.from == resource.data.from
                    && request.resource.data.to == resource.data.to;
      allow delete: if signedIn() && (me() == resource.data.from || me() == resource.data.to || isAdmin());
    }

    // ---------- chats (id = sorted uidA_uidB) ----------
    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || me() in resource.data.members || isAdmin());
      allow create: if active() && inChat(chatId) && me() in request.resource.data.members
                    && request.resource.data.members.size() == 2;
      allow update: if active() && inChat(chatId)
                    && request.resource.data.members.hasAll(resource.data.members)
                    && resource.data.members.hasAll(request.resource.data.members);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if signedIn() && (inChat(chatId) || isAdmin());
        allow create: if active() && inChat(chatId) && request.resource.data.senderId == me()
                      && (request.resource.data.get('text', '') is string)
                      && request.resource.data.get('text', '').size() <= 4000;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.senderId == me() || isAdmin());
      }
    }

    // ---------- reels / posts ----------
    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if active() && request.resource.data.uid == me();
      // owner can edit; anyone active may only change the like/comment counters
      allow update: if active() && (resource.data.uid == me()
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments']));
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if active() && me() == uid;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if active() && request.resource.data.uid == me() && request.resource.data.text.size() <= 500;
        // comment author, post owner, or admin can delete
        allow delete: if signedIn() && (resource.data.uid == me() || isAdmin()
                      || get(/databases/$(database)/documents/reels/$(reelId)).data.uid == me());
      }
    }

    // ---------- admin: SYNK News ----------
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /roadmap/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- feedback: anyone sends, only admins read ----------
    match /feedback/{id} {
      allow create: if active() && request.resource.data.uid == me()
                    && request.resource.data.status == 'open'
                    && request.resource.data.text.size() <= 1500;
      allow read, update, delete: if isAdmin();
    }

    // ---------- suspensions: only admins write; a user can see their own ----------
    match /bans/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
